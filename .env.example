APP_NAME="BulkSMS CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/BulkSms/public

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bulk_sms_laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS / Onfon
SMS_DEFAULT_COST=0.75
SMS_APPEND_REPLY_LINK=false
SMS_APPEND_STOP_FOOTER=false
ONFON_API_KEY=
ONFON_CLIENT_ID=

# ==========================================
# M-PESA DARAJA
# ==========================================
MPESA_ENV=sandbox

MPESA_SHORTCODE=
MPESA_PAYBILL=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

MPESA_STK_CALLBACK_URL="${APP_URL}/api/mpesa/stk/callback"
MPESA_CONFIRMATION_URL="${APP_URL}/api/mpesa/c2b/confirm"
MPESA_VALIDATION_URL="${APP_URL}/api/mpesa/c2b/validate"
MPESA_RESULT_URL="${APP_URL}/api/mpesa/b2c/result"
MPESA_TIMEOUT_URL="${APP_URL}/api/mpesa/b2c/timeout"
MPESA_REVERSAL_RESULT_URL="${APP_URL}/api/mpesa/reversal/result"
MPESA_REVERSAL_TIMEOUT_URL="${APP_URL}/api/mpesa/reversal/timeout"
